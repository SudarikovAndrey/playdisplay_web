# Наружу из api/ отдаётся только ai.php. Конфиг с ключами, библиотеки,
# стенограммы и папка писем закрыты — даже если кто-то угадает имя файла.

RedirectMatch 404 ^/api/config.*\.php$
RedirectMatch 404 ^/api/lib(/.*)?$
RedirectMatch 404 ^/api/sessions(/.*)?$
RedirectMatch 404 ^/api/outbox(/.*)?$
# Приложенные посетителями файлы. Наружу не отдаются НИКОГДА: они лежат тут только
# до отправки письма, и угаданное имя не должно превращаться в чужое ТЗ по ссылке.
RedirectMatch 404 ^/api/uploads(/.*)?$
RedirectMatch 404 ^/api/certs(/.*)?$

# Пароль на кнопку «Сохранить для всех» в панели настроек сцены. Внутри только соль и
# отпечаток, но отдавать наружу нечего: сам scene.php читает файл с диска.
RedirectMatch 404 ^/api/scene-pass\.php$
# Сохранённый на сервере набор настроек сцены. Наружу его отдаёт scene.php (с заголовком
# no-store), а прямой файл закрыт: nginx на этом хостинге раздаёт статику мимо Apache
# и повесил бы на него годовой кэш.
RedirectMatch 404 ^/api/scene-settings\.json$

# selftest.php — служебная страница проверки настроек. На боевом сервере закрыта:
# чтобы открыть, временно закомментируйте строку ниже.
RedirectMatch 404 ^/api/selftest\.php$

# Каталог не листается.
Options -Indexes

# Ответы ассистента не кэшируются ни браузером, ни прокси.
<IfModule mod_headers.c>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>
