# Конфигурация Apache для боевого хостинга (timeweb). На GitHub Pages не используется.
# Рассчитан на то, что сайт лежит В КОРНЕ домена playdisplay.com.
# Пока сайт живёт в подпапке /new/, на сервере поверх этого файла лежал
# незакоммиченный .htaccess с noindex — при переезде в корень он больше не нужен.
# Архив старого сайта 2021 года лежит в /old/ и закрыт от индексации своим .htaccess.

# ---------- служебное ----------
# .git тянется на сервер (деплой = git pull), поэтому наружу его отдавать нельзя.
RedirectMatch 404 ^/\.git
RedirectMatch 404 ^/\.nojekyll$

# ---------- типы ----------
AddType video/mp4 .mp4
AddType font/woff2 .woff2

# ---------- сжатие ----------
# Сайт отдаёт около 2,8 МБ текста на первую загрузку: index.html (564 КБ), два
# файла с картинками в base64 (по 750 КБ) и данные разделов. Текст жмётся в 4-5 раз,
# и это самая дешёвая победа на всём сайте — дешевле любой правки кода.
# Двоичное НЕ жмём: jpg, png, woff2 и mp4 уже сжаты, повторный проход только греет
# процессор и на шаред-хостинге отнимает время у настоящих запросов.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript text/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml image/svg+xml
  # Прокси должны хранить сжатую и несжатую версии раздельно, иначе клиенту без
  # gzip достанется сжатый ответ, который он не прочитает. Проверка на mod_headers
  # обязательна: без модуля директива Header роняет весь сайт в 500-ю, а какие
  # модули включены на шаред-хостинге, мы не решаем.
  <IfModule mod_headers.c>
    Header append Vary Accept-Encoding
  </IfModule>
</IfModule>

# ---------- кэш ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType font/otf "access plus 30 days"
  # Шрифты теперь наши: имена файлов не меняются, содержимое тоже — держим год.
  ExpiresByType font/woff2 "access plus 1 year"
  # ВНИМАНИЕ: ЭТИ ТРИ СТРОКИ НА БОЕВОМ НЕ РАБОТАЮТ. Проверено 16.08.2026 замером:
  #     curl -sI https://playdisplay.com/styles.css | grep -i 'cache-control\|server'
  #     → server: nginx/1.30.4 · cache-control: max-age=31536000
  # Статику на timeweb отдаёт nginx НАПРЯМУЮ, до Apache запрос не доходит, и
  # mod_expires для css/js/woff2 не исполняется вовсе — nginx ставит свой год.
  # (Разметка и json идут через Apache, там правила ниже действуют: max-age=0.)
  # Вдобавок nginx зовёт скрипты application/x-javascript, а не application/javascript,
  # так что даже в Apache строка ниже по типу бы не совпала.
  #
  # Оставлены НАМЕРЕННО, как запись найденного: убрать их — и следующий человек
  # снова полдня будет думать, почему кэш не слушается. Настоящее лекарство другое
  # и уже применено: build_seo.py проставляет ?v=<хеш содержимого> ссылкам на
  # styles.css и analytics.js, поэтому изменившийся файл получает новый адрес и
  # годовой кэш ему не помеха. Если понадобится управлять кэшем статики всерьёз —
  # это разговор с поддержкой timeweb про конфиг nginx, а не правка здесь.
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  # Разметку и данные не кэшируем: их правим чаще всего, и они лёгкие после сжатия.
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# ---------- один адрес сайта ----------
# playdisplay.ru, www.playdisplay.ru и www.playdisplay.com отдавали содержание САМИ,
# а не перенаправляли: у поисковиков это три копии сайта, у аналитики — рваная сессия
# при переходе между доменами. Один canonical в разметке проблему не решает: canonical
# лишь подсказка, а 301 — указание.
#
# Условие написано «всё, кроме playdisplay.com», а не перечислением доменов: перечисление
# надо пополнять при каждом новом алиасе, а забыть его легко. Правило стоит ПЕРВЫМ:
# иначе адреса старого вордпресса сначала уедут на нужную страницу, а потом их ещё раз
# перебросит уже с другого домена — две 301-и подряд поисковики не любят.
# Флаг NE обязателен: без него Apache экранирует служебные знаки в цели.
RewriteCond %{HTTP_HOST} !^playdisplay\.com$ [NC]
RewriteCond %{HTTP_HOST} !^$
RewriteRule ^(.*)$ https://playdisplay.com/$1 [R=301,L,NE]

# ---------- разделы старого сайта на вордпрессе ----------
# ФЛАГ NE ЗДЕСЬ КРИТИЧЕН. Без него Apache превращает решётку в %23, и вместо
# playdisplay.com/#work посетитель попадал на playdisplay.com/%23work — то есть в 404.
# Проверено на боевом 17.08.2026: все три адреса отдавали «404 Not Found».
RewriteRule ^projects/?$ /#work [R=301,L,NE]
RewriteRule ^about/?$ /#studio [R=301,L,NE]
RewriteRule ^contact/?$ /#contact [R=301,L,NE]

# ---------- кейсы, у которых сменился адрес ----------
# Слева — как было на вордпрессе, справа — как стало на новом сайте.
RewriteRule ^work/аэропорты-россии/?$ /work/airports/ [R=301,L]
RewriteRule ^work/одк-оак/?$ /work/odk-oak/ [R=301,L]
RewriteRule ^work/ростех-экспо/?$ /work/rostec/ [R=301,L]
RewriteRule ^work/судостроение/?$ /work/industry-rf/ [R=301,L]
RewriteRule ^work/vdnh_space/?$ /work/vdnh-space/ [R=301,L]
RewriteRule ^work/vdnh_space-2/?$ /work/vdnh-space-center/ [R=301,L]
RewriteRule ^work/stallingrad/?$ /work/stalingrad/ [R=301,L]

# ---------- работы, которых на новом сайте нет ----------
# jihi-studio-lamp, holocube_s, petrol-bowl, summer-17, changi2016, оживайка —
# уводим в архив, а не в 404. Условия обязательны: если страница на новом сайте
# существует, правило не срабатывает и отдаётся она.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^work/(.+?)/?$ /old/work/$1/ [R=302,L]

# ---------- остатки вордпресса ----------
RewriteRule ^(feed|comments/feed)/?$ / [R=301,L]
RewriteRule ^xmlrpc\.php$ / [R=301,L]
RewriteRule ^wp-(login|admin|content|includes|json)(/.*)?$ / [R=301,L]
</IfModule>
