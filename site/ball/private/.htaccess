# Вёрстка концепции лежит здесь, и веб-сервер не отдаёт её НИКОМУ напрямую:
# страницу выдаёт только ../index.php, и только после проверки пароля.
# Два синтаксиса подряд — на случай Apache 2.2 и 2.4 (на хостинге бывает и то и то).
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
