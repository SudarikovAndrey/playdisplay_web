# Архив прошлых поколений сайта и рабочих материалов — см. _ARCHIVE/README.md.
# Лежит рядом «на всякий случай», в репозиторий не попадает.
_ARCHIVE/
production/

# Системное и служебное
.DS_Store
node_modules/

# Мастера видео и 3D-исходники: тяжёлые, ломают push (лимит GitHub 100 МБ).
# На сайте раздаются сжатые копии из site/videos/ — они отслеживаются.
videos/
*.blend
*.fbx
*.aep

# Архивы-слепки: сайт собирается из site/, а не из zip
*.zip

# AI-ассистент: ключи модели и пароль почтового ящика. Образец — config.sample.php.
site/api/config.php
# Стенограммы разговоров, счётчики лимитов и письма драйвера file — это данные, не код.
site/api/sessions/
site/api/outbox/
# Приложенные посетителями файлы. Живут до отправки письма, потом удаляются;
# в репозитории им тем более не место.
site/api/uploads/

# Другой проект, случайно попавший в эту папку: в репозиторий сайта не входит
samizdat/

# Локальные настройки деплоя (адрес сервера, путь). Образец — deploy.conf.sample.
deploy.conf
site/avtovaz/material/

# venv для конвертации картинок (Pillow). Создаётся _tools/make_webp.py, в git не нужен.
_tools/venv/
__pycache__/
